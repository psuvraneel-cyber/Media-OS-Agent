# =============================================================================
# Media Intelligence OS - Environment Variable Template (PLACEHOLDERS ONLY)
# Copy this file to `.env` locally when later implementation phases require it.
# NEVER commit `.env` or real credentials to Git.
# NEVER expose backend API keys to frontend Next.js (`NEXT_PUBLIC_*`) variables.
# =============================================================================

# --- Application Runtime (Phase 1 Docker Baseline + Phase 3-4 App Stack) ---
APP_ENV=development
LOG_LEVEL=INFO
APP_DISPLAY_TIMEZONE=Asia/Kolkata
API_HOST=127.0.0.1
API_PORT=8000
WEB_PORT=3000

# --- Single-Owner Local Authentication (Fail-Closed Required Runtime Values) ---
# Generate OWNER_PASSWORD_HASH and SESSION_SECRET using:
#   .venv\Scripts\python -m media_os_api.auth.bootstrap --output "C:\Media OS Agent\media-os-runtime\.env"
OWNER_USERNAME=REPLACE_WITH_OWNER_USERNAME
OWNER_PASSWORD_HASH_B64=REPLACE_WITH_BASE64_ARGON2ID_HASH
SESSION_SECRET=REPLACE_WITH_RANDOM_64_HEX_SESSION_SECRET
SESSION_TTL_SECONDS=28800
# COOKIE_SECURE=false is only accepted when all CORS_ALLOWED_ORIGINS are loopback URLs.
COOKIE_SECURE=false
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
RATE_LIMIT_FAIL_CLOSED_ON_REDIS_OUTAGE=false
INTERNAL_API_BASE_URL=http://127.0.0.1:8000

# --- Application PostgreSQL (Phase 4 - Separate from Postiz DB) ---
POSTGRES_HOST=media-os-postgres
POSTGRES_PORT=5432
POSTGRES_DB=media_os
POSTGRES_USER=media_os_user
POSTGRES_PASSWORD=REPLACE_WITH_LOCAL_POSTGRES_PASSWORD
DATABASE_URL=postgresql+psycopg://media_os_user:REPLACE_WITH_LOCAL_POSTGRES_PASSWORD@media-os-postgres:5432/media_os

# --- Application Redis & Celery (Phase 4 - Separate from Postiz Redis) ---
REDIS_HOST=media-os-redis
REDIS_PORT=6379
REDIS_PASSWORD=REPLACE_WITH_LOCAL_REDIS_PASSWORD
REDIS_URL=redis://:REPLACE_WITH_LOCAL_REDIS_PASSWORD@media-os-redis:6379/0
CELERY_BROKER_URL=redis://:REPLACE_WITH_LOCAL_REDIS_PASSWORD@media-os-redis:6379/0
CELERY_RESULT_BACKEND=redis://:REPLACE_WITH_LOCAL_REDIS_PASSWORD@media-os-redis:6379/1

# --- Gemini Developer API (Future Phase 7 - DO NOT enter keys yet) ---
# Centralized provider adapter configuration (NO account rotation to bypass 429 quotas)
GEMINI_API_KEY=REPLACE_WITH_GEMINI_API_KEY
GEMINI_TEXT_MODEL=VERIFY_IN_PHASE_7
GEMINI_TTS_MODEL=VERIFY_IN_PHASE_7
GEMINI_DAILY_TOKEN_BUDGET=0
GEMINI_DAILY_COST_CAP_USD=0.00
GEMINI_MAX_CONCURRENT_REQUESTS=1

# --- Free-tier AI providers (N1). Free keys only: never enable billing; one key per provider. ---
# A provider whose key is missing or still a placeholder is skipped by the router.
GROQ_API_KEY=REPLACE_WITH_GROQ_API_KEY
OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_API_KEY
CLOUDFLARE_API_TOKEN=REPLACE_WITH_CLOUDFLARE_WORKERS_AI_TOKEN
CLOUDFLARE_ACCOUNT_ID=REPLACE_WITH_CLOUDFLARE_ACCOUNT_ID
# Optional JSON overrides (see media_os_api/ai/config.py); leave empty for the defaults.
AI_ROUTES=
AI_QUOTA_LIMITS=

# --- Postiz Separate Publishing Service Boundary (Future Phase 2 & Phase 8) ---
# Postiz runs in its own Compose stack (verified default port 4007).
# Communicate ONLY via supported Public API or MCP interfaces.
POSTIZ_BASE_URL=http://127.0.0.1:4007
POSTIZ_API_BASE_URL=http://127.0.0.1:4007/api/public/v1
POSTIZ_API_KEY=REPLACE_WITH_POSTIZ_API_KEY

# --- Owner alerts (Telegram) ---
# Create a bot with @BotFather, send it /start, then put its token and your chat id here.
# Leave empty to run without alerts. The token is a secret: never commit or share it.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
MEDIA_OS_DASHBOARD_URL=http://127.0.0.1:3100

# --- Future Optional Media Hosting (Subject to Explicit Owner Approval) ---
# Required before production Instagram Graph API publishing (needs public HTTPS URLs)
CLOUDFLARE_R2_ENABLED=false
CLOUDFLARE_R2_ACCOUNT_ID=REPLACE_WITH_R2_ACCOUNT_ID
CLOUDFLARE_R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
CLOUDFLARE_R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
CLOUDFLARE_R2_BUCKET=REPLACE_WITH_R2_BUCKET
CLOUDFLARE_R2_PUBLIC_BASE_URL=https://REPLACE_WITH_APPROVED_PUBLIC_MEDIA_DOMAIN

# --- Source Connectors Policy Flags (Future Phase 5) ---
# Reddit MUST remain BLOCKED until permitted-use & Data API Terms review is completed.
SOURCE_REDDIT_STATUS=BLOCKED
SOURCE_GOOGLE_TRENDS_STATUS=EXPERIMENTAL

# Research ingestion (Phase 5). Live fetches need this AND per-source owner approval.
RESEARCH_LIVE_FETCH_ENABLED=false
# Optional read-only fine-grained GitHub token (public repositories only). Leave empty for none.
GITHUB_TOKEN=
